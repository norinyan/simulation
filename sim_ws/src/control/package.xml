<?xml version="1.0"?>
<package format="3">
  <name>control</name><version>0.1.0</version>
  <description>Robot spawning and ideal wheel-foot trajectory execution.</description>
  <maintainer email="norin@example.com">Norin</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>planning</depend>
  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
