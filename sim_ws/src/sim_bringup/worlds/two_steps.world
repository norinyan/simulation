            <diffuse>0.70 0.52 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 上平台 X=[2.70,11.35]，顶面 Z=0.34，与第二级齐平，无第三级高度变化。 -->
    <model name="upper_platform">
      <static>true</static>
      <pose>7.025 0 0.17 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
