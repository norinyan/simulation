<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="two_steps">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.52 0.52 0.52 1</ambient>
      <background>0.87 0.81 0.71 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.4 0.2 -1</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>
    <!-- 地基位于围墙内侧：X=[-6.85,11.35]、Y=[-3.825,3.825]；下层顶面 Z=0。 -->
    <model name="lower_ground">
      <static>true</static>
      <pose>2.25 0 -0.10 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>18.2 7.65 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>18.2 7.65 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.81 0.73 0.57 1</ambient>
            <diffuse>0.81 0.73 0.57 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 两级楼梯共用暖沙色，两个平台共用奶油色；外围侧面由同色全高围墙封闭。 -->
    <!-- 恰好两级：第一级 X=[2.00,2.35] 顶面 Z=0.17；第二级 X=[2.35,2.70] 顶面 Z=0.34。 -->
    <model name="step_1">
      <static>true</static>
      <pose>2.175 0 0.085 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 7.65 0.17</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.35 7.65 0.17</size>
            </box>
          </geometry>
          <material>
            <ambient>0.70 0.52 0.30 1</ambient>
            <diffuse>0.70 0.52 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_2">
      <static>true</static>
      <pose>2.525 0 0.17 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 7.65 0.34</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
